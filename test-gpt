{
  "log": {
    "level": "info"
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "Local-DNS",
        "server": "dns.alidns.com",
        "domain_resolver": "Local-DNS-Resolver"
      },
      {
        "type": "udp",
        "tag": "Local-DNS-Resolver",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "Remote-DNS",
        "server": "dns.google",
        "domain_resolver": "Remote-DNS-Resolver",
        "detour": "🚀 节点选择"
      },
      {
        "type": "udp",
        "tag": "Remote-DNS-Resolver",
        "server": "8.8.8.8",
        "detour": "🚀 节点选择"
      }
    ],
    "rules": [
      {
        "clash_mode": "direct",
        "action": "route",
        "server": "Local-DNS"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "server": "Remote-DNS"
      },
      {
        "rule_set": "cn",
        "action": "route",
        "server": "Local-DNS"
      }
    ],
    "final": "Remote-DNS",
    "disable_cache": true,
    "reverse_mapping": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 20122
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "🚀 节点选择",
      "outbounds": ["direct"],
      "default": "direct",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "ChinaRouter",
      "outbounds": ["direct"],
      "default": "direct",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "🐟 漏网之鱼",
      "outbounds": ["🚀 节点选择", "direct"],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "GLOBAL",
      "outbounds": ["🚀 节点选择", "direct", "🐟 漏网之鱼"],
      "interrupt_exist_connections": true
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "http_clients": [
    {
      "tag": "rules-download",
      "detour": "direct"
    }
  ],
  "route": {
    "rule_set": [
      {
        "type": "remote",
        "tag": "private",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/private.srs"
      },
      {
        "type": "remote",
        "tag": "private_ip",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/privateip.srs"
      },
      {
        "type": "remote",
        "tag": "httpdns",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/QuixoticHeart/rule-set@ruleset/singbox/version5/httpdns.srs"
      },
      {
        "type": "remote",
        "tag": "pcdn",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/VoidFoxGod/pcdn-rules@main/pcdn.srs"
      },
      {
        "type": "remote",
        "tag": "adrules",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/ads.srs"
      },
      {
        "type": "remote",
        "tag": "proxy",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/proxy.srs"
      },
      {
        "type": "remote",
        "tag": "cn",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/cn.srs"
      },
      {
        "type": "remote",
        "tag": "cn_ip",
        "format": "binary",
        "url": "https://gcore.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/cnip.srs"
      }
    ],
    "rules": [
      {
        "inbound": "tun-in",
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "outbound": "GLOBAL"
      },
      {
        "network": "icmp",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": ["private", "private_ip"],
        "action": "route",
        "outbound": "direct"
      },
      {
        "protocol": ["quic", "stun"],
        "action": "reject"
      },
      {
        "rule_set": ["httpdns", "pcdn", "adrules"],
        "action": "reject"
      },
      {
        "rule_set": "proxy",
        "action": "route",
        "outbound": "🚀 节点选择"
      },
      {
        "rule_set": ["cn", "cn_ip"],
        "action": "route",
        "outbound": "ChinaRouter"
      }
    ],
    "auto_detect_interface": true,
    "default_http_client": "rules-download",
    "default_domain_resolver": "Local-DNS",
    "final": "🐟 漏网之鱼"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:20123",
      "default_mode": "rule",
      "access_control_allow_origin": ["*"]
    },
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "cache_id": "standalone-1-15"
    }
  }
}
